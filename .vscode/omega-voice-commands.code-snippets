{
    "Omega Voice Command": {
        "prefix": "omega-voice",
        "body": [
            "// OMEGA Voice Command: ${1:command}",
            "// Transcribed: ${2:text}",
            "// Timestamp: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE} ${CURRENT_HOUR}:${CURRENT_MINUTE}",
            "$0"
        ],
        "description": "Insert voice command transcription"
    },
    "Omega Screenshot Note": {
        "prefix": "omega-screenshot",
        "body": [
            "/*",
            " * SCREENSHOT: ${1:description}",
            " * File: ${2:screenshot.png}",
            " * Notes: ${3:markup notes}",
            " * Time: ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE} ${CURRENT_HOUR}:${CURRENT_MINUTE}",
            " */",
            "$0"
        ],
        "description": "Insert screenshot reference with notes"
    },
    "Omega Task from Voice": {
        "prefix": "omega-task",
        "body": [
            "// TODO: ${1:task from voice}",
            "// Priority: ${2|high,medium,low|}",
            "// Assigned: OMEGA",
            "// Status: ${3|pending,in-progress,done|}",
            "$0"
        ],
        "description": "Create task from voice input"
    }
}