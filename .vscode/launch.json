{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Omega Web UI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/omega_control_panel_web.py",
            "args": [
                "--port",
                "5000"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Launch Omega Web UI (Debug)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/omega_control_panel_web.py",
            "args": [
                "--port",
                "5000",
                "--debug"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        }
    ]
}