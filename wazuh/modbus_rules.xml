<?xml version="1.0" encoding="UTF-8"?>
<!--
  Modbus-Specific Wazuh Rules
  ============================
  Custom rules for detecting malicious Modbus TCP/RTU activity in ICS/OT environments.
  Includes MITRE ATT&CK for ICS mappings.
  
  Installation:
    1. Copy to /var/ossec/etc/rules/modbus_rules.xml
    2. chown wazuh:wazuh modbus_rules.xml
    3. chmod 660 modbus_rules.xml
    4. systemctl restart wazuh-manager
  
  Test with: /var/ossec/bin/wazuh-logtest
  
  Rule IDs: 200000-200999 (reserved for Modbus/ICS rules)
-->

<group name="ics,modbus,ot,scada,">

  <!-- Level 0: Base Modbus event (parent for chaining) -->
  <rule id="200000" level="0">
    <decoded_as>modbus-json|modbus-syslog-detail|modbus-req|modbus-resp</decoded_as>
    <description>Base Modbus TCP/RTU event</description>
  </rule>

  <!-- ============================================ -->
  <!-- Reconnaissance Rules -->
  <!-- ============================================ -->

  <!-- Level 7: Read Device Identification (fingerprinting) -->
  <rule id="200010" level="7">
    <if_sid>200000</if_sid>
    <field name="function_code">43|0x2B</field>
    <field name="sub_function">14|0x0E</field>
    <description>Modbus Read Device Identification (FC 43/14) - potential device fingerprinting</description>
    <mitre>
      <id>T0801</id>  <!-- Monitor Process State (Discovery) -->
    </mitre>
    <group>ics,discovery,reconnaissance,modbus,</group>
  </rule>

  <!-- Level 8: Diagnostics - Return Query Data (loopback) -->
  <rule id="200011" level="8">
    <if_sid>200000</if_sid>
    <field name="function_code">8|0x08</field>
    <field name="sub_function">0|0x0000</field>
    <description>Modbus Diagnostics - Return Query Data (sub 0x0000) - potential device probing</description>
    <mitre>
      <id>T0801</id>
      <id>T0802</id>  <!-- Network Sniffing -->
    </mitre>
    <group>ics,reconnaissance,diagnostics,modbus,</group>
  </rule>

  <!-- ============================================ -->
  <!-- Write Operation Rules (High Risk) -->
  <!-- ============================================ -->

  <!-- Level 12: Write Single Coil/Register (direct control) -->
  <rule id="200020" level="12">
    <if_sid>200000</if_sid>
    <field name="function_code">5|6|0x05|0x06</field>
    <description>Modbus unauthorized single write (FC 05/06) - potential process manipulation</description>
    <mitre>
      <id>T0831</id>  <!-- Manipulation of Control -->
      <id>T0835</id>  <!-- Manipulate I/O Image -->
    </mitre>
    <group>ics,impair_process_control,write_operation,modbus,</group>
  </rule>

  <!-- Level 14: Write Multiple Coils/Registers (bulk control) -->
  <rule id="200021" level="14">
    <if_sid>200000</if_sid>
    <field name="function_code">15|16|0x0F|0x10</field>
    <field name="quantity">^10$|^[1-9][0-9]+$</field>
    <description>Modbus multiple write (FC 15/16) with large quantity - high risk of mass manipulation</description>
    <mitre>
      <id>T0831</id>
      <id>T0805</id>  <!-- Denial of Service -->
    </mitre>
    <group>ics,impair_process_control,critical_write,modbus,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- Level 13: Write from unauthorized source -->
  <rule id="200022" level="13">
    <if_sid>200020,200021</if_sid>
    <field name="srcip" negate="yes">^192\.168\.10\.|^10\.0\.50\.</field>
    <description>Modbus write from unauthorized IP - possible rogue master</description>
    <mitre>
      <id>T0848</id>  <!-- Rogue Master -->
    </mitre>
    <group>ics,unauthorized_access,impair_process_control,modbus,</group>
  </rule>

  <!-- ============================================ -->
  <!-- Exception & DoS Rules -->
  <!-- ============================================ -->

  <!-- Level 10: Exception flood (potential DoS) -->
  <rule id="200030" level="10" frequency="8" timeframe="120">
    <if_matched_sid>200000</if_matched_sid>
    <field name="exception">true</field>
    <same_srcip/>
    <description>Multiple Modbus exceptions from same source - possible DoS or malformed commands</description>
    <mitre>
      <id>T0814</id>  <!-- Denial of Service -->
    </mitre>
    <group>ics,denial_of_service,modbus,</group>
  </rule>

  <!-- ============================================ -->
  <!-- Correlation Rules -->
  <!-- ============================================ -->

  <!-- Level 15: Repeated writes in short time (automation attack) -->
  <rule id="200050" level="15" frequency="5" timeframe="300" ignore="600">
    <if_matched_sid>200020</if_matched_sid>
    <same_srcip/>
    <description>Multiple single Modbus writes in 5 minutes from same source - likely automation attack</description>
    <mitre>
      <id>T0831</id>
    </mitre>
    <group>ics,impair_process_control,attack_pattern,modbus,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- Level 12: Multiple diagnostics in short time (scanning) -->
  <rule id="200051" level="12" frequency="6" timeframe="180">
    <if_matched_sid>200011</if_matched_sid>
    <same_srcip/>
    <description>Multiple Modbus Diagnostics requests in 3 minutes from same source - possible scanning/recon</description>
    <mitre>
      <id>T0801</id>
    </mitre>
    <group>ics,reconnaissance,attack_pattern,modbus,</group>
  </rule>

  <!-- ============================================ -->
  <!-- Critical Diagnostics Rules (TA0107) -->
  <!-- ============================================ -->

  <!-- Level 14: Force Listen Only Mode (device isolation) -->
  <rule id="200062" level="14">
    <if_sid>200000</if_sid>
    <field name="function_code">8|0x08</field>
    <field name="sub_function">4|0x0004</field>
    <description>Modbus Diagnostics - Force Listen Only Mode (sub 0x0004) - device isolation attempt</description>
    <mitre>
      <id>T0858</id>  <!-- Change Operating Mode -->
      <id>T0814</id>  <!-- Denial of Service -->
    </mitre>
    <group>ics,denial_of_service,impair_process_control,critical,modbus,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- Level 11: Clear Counters (hiding tracks) -->
  <rule id="200063" level="11">
    <if_sid>200000</if_sid>
    <field name="function_code">8|0x08</field>
    <field name="sub_function">10|0x000A</field>
    <description>Modbus Diagnostics - Clear Counters (sub 0x000A) - possible cover-up</description>
    <mitre>
      <id>T0872</id>  <!-- Indicator Removal on Host -->
    </mitre>
    <group>ics,evasion,diagnostics,modbus,</group>
  </rule>

</group>
