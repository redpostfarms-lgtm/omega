<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gatekeeper-Specific Wazuh Decoders
  ===================================
  Custom decoders for parsing Gatekeeper security system logs.
  
  Installation:
    1. Copy to /var/ossec/etc/decoders/gatekeeper_decoders.xml
    2. chown wazuh:wazuh gatekeeper_decoders.xml
    3. chmod 660 gatekeeper_decoders.xml
    4. systemctl restart wazuh-manager
  
  Test with: /var/ossec/bin/wazuh-logtest
-->

<decoder name="gatekeeper">
  <!-- Parent decoder: Matches any Gatekeeper log -->
  <program_name>^gatekeeper$</program_name>
</decoder>

<decoder name="gatekeeper-json">
  <!-- JSON-formatted Gatekeeper logs (recommended format) -->
  <prematch>json_event: </prematch>
</decoder>

<decoder name="gatekeeper-json-detail">
  <!-- Extracts all JSON keys as dynamic fields -->
  <parent>gatekeeper-json</parent>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>

<decoder name="gatekeeper-anomaly">
  <!-- Gatekeeper anomaly detection log -->
  <parent>gatekeeper</parent>
  <prematch>^Gatekeeper: ANOMALY DETECTED - </prematch>
</decoder>

<decoder name="gatekeeper-anomaly-detail">
  <!-- Extracts anomaly type, source IP, count, threshold, time -->
  <parent>gatekeeper-anomaly</parent>
  <regex type="pcre2">type=(\S+) src=(\S+) count=(\d+) threshold=(\d+) time=(\S+)</regex>
  <order>anomaly_type, srcip, anomaly_count, threshold, anomaly_time</order>
  <offset>after_prematch</offset>
</decoder>

<decoder name="gatekeeper-threat">
  <!-- Gatekeeper threat detection log -->
  <parent>gatekeeper</parent>
  <prematch>^Gatekeeper: THREAT DETECTED - </prematch>
</decoder>

<decoder name="gatekeeper-threat-detail">
  <!-- Extracts threat level, source, description, category -->
  <parent>gatekeeper-threat</parent>
  <regex type="pcre2">level=(\S+) source=(\S+) desc=(.*?) category=(\S+)</regex>
  <order>threat_level, srcip, threat_desc, threat_category</order>
  <offset>after_prematch</offset>
</decoder>

<decoder name="gatekeeper-roe">
  <!-- Gatekeeper Rules of Engagement (ROE) violation log -->
  <parent>gatekeeper</parent>
  <prematch>^Gatekeeper: ROE VIOLATION - </prematch>
</decoder>

<decoder name="gatekeeper-roe-detail">
  <!-- Extracts ROE violation type, source, timestamp -->
  <parent>gatekeeper-roe</parent>
  <regex type="pcre2">violation=(\S+) src=(\S+) time=(\S+) action=(\S+)</regex>
  <order>roe_violation, srcip, roe_time, roe_action</order>
  <offset>after_prematch</offset>
</decoder>

<decoder name="gatekeeper-counterstrike">
  <!-- Gatekeeper counterstrike/response log -->
  <parent>gatekeeper</parent>
  <prematch>^Gatekeeper: COUNTERSTRIKE - </prematch>
</decoder>

<decoder name="gatekeeper-counterstrike-detail">
  <!-- Extracts counterstrike target, port, method, timestamp -->
  <parent>gatekeeper-counterstrike</parent>
  <regex type="pcre2">target=(\S+) port=(\d+) method=(\S+) time=(\S+)</regex>
  <order>counterstrike_target, counterstrike_port, counterstrike_method, counterstrike_time</order>
  <offset>after_prematch</offset>
</decoder>

<decoder name="gatekeeper-pipe">
  <!-- Pipe-delimited Gatekeeper log format -->
  <prematch type="pcre2">^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2} \|</prematch>
</decoder>

<decoder name="gatekeeper-pipe-detail">
  <!-- Extracts timestamp, level, component, message, source IP -->
  <parent>gatekeeper-pipe</parent>
  <regex type="pcre2">^(\S+) \| (\S+) \| (\S+) \| (.*) from (\S+)</regex>
  <order>timestamp, log_level, component, message, srcip</order>
</decoder>

<decoder name="gatekeeper-syslog">
  <!-- Syslog-style Gatekeeper log (RFC 3164/5424) -->
  <program_name>^gatekeeper</program_name>
  <prematch>Gatekeeper: </prematch>
</decoder>
