<?xml version="1.0" encoding="UTF-8"?>
<!--
  Gatekeeper-Specific Wazuh Rules
  ================================
  Custom rules for detecting threats and anomalies in Gatekeeper security system logs.
  Includes MITRE ATT&CK mappings for enterprise and ICS contexts.
  
  Installation:
    1. Copy to /var/ossec/etc/rules/gatekeeper_rules.xml
    2. chown wazuh:wazuh gatekeeper_rules.xml
    3. chmod 660 gatekeeper_rules.xml
    4. systemctl restart wazuh-manager
  
  Test with: /var/ossec/bin/wazuh-logtest
  
  Rule IDs: 100000-100999 (reserved for Gatekeeper custom rules)
-->

<group name="gatekeeper,anomaly,threat_detection,">

  <!-- Level 0: Base anomaly event (parent for chaining) -->
  <rule id="100200" level="0">
    <decoded_as>gatekeeper-anomaly</decoded_as>
    <description>Gatekeeper base anomaly event</description>
  </rule>

  <!-- Level 10: Network spike anomaly -->
  <rule id="100201" level="10">
    <if_sid>100200</if_sid>
    <field name="anomaly_type">network_spike</field>
    <description>Gatekeeper network spike anomaly detected</description>
    <mitre>
      <id>T1499</id>  <!-- Endpoint Denial of Service -->
    </mitre>
    <group>gatekeeper,network_attack,anomaly,</group>
  </rule>

  <!-- Level 13: Multiple network spikes (correlation) -->
  <rule id="100202" level="13" frequency="5" timeframe="300" ignore="600">
    <if_matched_sid>100201</if_matched_sid>
    <same_srcip/>
    <description>Multiple Gatekeeper network spikes in 5 minutes from same source - possible attack</description>
    <mitre>
      <id>T1499</id>
      <id>T1595</id>  <!-- Active Scanning -->
    </mitre>
    <group>gatekeeper,bruteforce,attack,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- Level 10: Port scan anomaly -->
  <rule id="100203" level="10">
    <if_sid>100200</if_sid>
    <field name="anomaly_type">port_scan</field>
    <description>Gatekeeper port scan anomaly detected</description>
    <mitre>
      <id>T1046</id>  <!-- Network Service Scanning -->
      <id>T1595.002</id>  <!-- Vulnerability Scanning -->
    </mitre>
    <group>gatekeeper,reconnaissance,scanning,</group>
  </rule>

  <!-- Level 12: Repeated port scans -->
  <rule id="100204" level="12" frequency="8" timeframe="600">
    <if_matched_sid>100203</if_matched_sid>
    <same_srcip/>
    <description>Multiple Gatekeeper port scans from same source - aggressive reconnaissance</description>
    <mitre>
      <id>T1046</id>
      <id>T1595.002</id>
    </mitre>
    <group>gatekeeper,reconnaissance,attack,</group>
  </rule>

</group>

<group name="gatekeeper,threat,detection,">

  <!-- Level 0: Base threat event -->
  <rule id="100300" level="0">
    <decoded_as>gatekeeper-threat</decoded_as>
    <description>Gatekeeper base threat event</description>
  </rule>

  <!-- Level 12: High-level threat -->
  <rule id="100301" level="12">
    <if_sid>100300</if_sid>
    <field name="threat_level">high|critical</field>
    <description>Gatekeeper HIGH/CRITICAL threat detected</description>
    <mitre>
      <id>T1204</id>  <!-- User Execution -->
      <id>T1059</id>  <!-- Command and Scripting Interpreter -->
    </mitre>
    <group>gatekeeper,threat,attack,</group>
  </rule>

  <!-- Level 14: Critical threat with correlation -->
  <rule id="100302" level="14" frequency="3" timeframe="300">
    <if_matched_sid>100301</if_matched_sid>
    <same_srcip/>
    <description>Multiple Gatekeeper critical threats from same source - targeted attack</description>
    <mitre>
      <id>T1204</id>
      <id>T1059</id>
    </mitre>
    <group>gatekeeper,threat,attack,critical,</group>
    <options>alert_by_email</options>
  </rule>

</group>

<group name="gatekeeper,roe,violation,">

  <!-- Level 0: Base ROE violation event -->
  <rule id="100400" level="0">
    <decoded_as>gatekeeper-roe</decoded_as>
    <description>Gatekeeper base ROE violation event</description>
  </rule>

  <!-- Level 14: Unauthorized execution violation -->
  <rule id="100401" level="14">
    <if_sid>100400</if_sid>
    <field name="roe_violation">unauthorized_execution</field>
    <description>Gatekeeper ROE violation: Unauthorized code execution detected</description>
    <mitre>
      <id>T1059</id>  <!-- Command and Scripting Interpreter -->
      <id>T1204</id>  <!-- User Execution -->
    </mitre>
    <group>gatekeeper,roe,execution,violation,</group>
    <options>alert_by_email</options>
  </rule>

  <!-- Level 13: Unauthorized access violation -->
  <rule id="100402" level="13">
    <if_sid>100400</if_sid>
    <field name="roe_violation">unauthorized_access</field>
    <description>Gatekeeper ROE violation: Unauthorized access detected</description>
    <mitre>
      <id>T1078</id>  <!-- Valid Accounts -->
      <id>T1133</id>  <!-- External Remote Services -->
    </mitre>
    <group>gatekeeper,roe,access,violation,</group>
  </rule>

  <!-- Level 15: Multiple ROE violations from same source -->
  <rule id="100403" level="15" frequency="5" timeframe="600">
    <if_matched_sid>100400</if_matched_sid>
    <same_srcip/>
    <description>Multiple Gatekeeper ROE violations from same source - systematic attack</description>
    <mitre>
      <id>T1059</id>
      <id>T1078</id>
    </mitre>
    <group>gatekeeper,roe,violation,attack,critical,</group>
    <options>alert_by_email</options>
  </rule>

</group>

<group name="gatekeeper,counterstrike,response,">

  <!-- Level 8: Base counterstrike event (informational) -->
  <rule id="100500" level="8">
    <decoded_as>gatekeeper-counterstrike</decoded_as>
    <description>Gatekeeper counterstrike/response activated</description>
    <group>gatekeeper,counterstrike,response,</group>
  </rule>

  <!-- Level 11: Counterstrike against high-value target -->
  <rule id="100501" level="11">
    <if_sid>100500</if_sid>
    <field name="counterstrike_method">quantum_nuke|decohere</field>
    <description>Gatekeeper quantum counterstrike payload deployed</description>
    <mitre>
      <id>T1498</id>  <!-- Network Denial of Service -->
    </mitre>
    <group>gatekeeper,counterstrike,quantum,response,</group>
  </rule>

  <!-- Level 12: Repeated counterstrikes (possible escalation) -->
  <rule id="100502" level="12" frequency="3" timeframe="300">
    <if_matched_sid>100501</if_matched_sid>
    <same_srcip/>
    <description>Multiple Gatekeeper quantum counterstrikes against same target - escalated response</description>
    <mitre>
      <id>T1498</id>
    </mitre>
    <group>gatekeeper,counterstrike,escalation,</group>
  </rule>

</group>
