{
    "folders": [
        {
            "path": "."
        }
    ],
    "settings": {
        "python.defaultInterpreterPath": "python",
        "python.terminal.activateEnvironment": true,
        "files.exclude": {
            "**/__pycache__": true,
            "**/*.pyc": true,
            "**/node_modules": true
        },
        "python.analysis.extraPaths": [
            "${workspaceFolder}"
        ],
        "python.autoComplete.extraPaths": [
            "${workspaceFolder}"
        ],
        "files.watcherExclude": {
            "**/__pycache__/**": true,
            "**/node_modules/**": true,
            "**/.git/**": true
        },
        "task.autoDetect": "on",
        "task.quickOpen.history": 10
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Launch Omega Web UI",
                "type": "shell",
                "command": "python",
                "args": [
                    "AUTO_LAUNCH_UI.py"
                ],
                "problemMatcher": [],
                "presentation": {
                    "reveal": "always",
                    "panel": "new"
                },
                "isBackground": true
            }
        ]
    }
}