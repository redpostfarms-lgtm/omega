    def calculate_education_score(self):
        """Calculate education completion score"""
        total_categories = 5  # ai_ml, data_science, web_dev, security, performance
        completed_categories = len(self.knowledge_base["categories"])

        # Calculate depth of knowledge in each category
        total_topics = sum(len(cat) for cat in self.knowledge_base["categories"].values())

        # Score based on breadth and depth
        breadth_score = (completed_categories / total_categories) * 50
        depth_score = min(50, (total_topics / 20) * 50)  # 20 topics = 100% depth

        education_score = breadth_score + depth_score
        self.knowledge_base["completion_score"] = education_score

        return education_score

    def generate_knowledge_report(self):
        """Generate comprehensive knowledge base report"""
        report_path = self.project_root / "OMEGA_KNOWLEDGE_BASE.json"

        with open(report_path, "w", encoding="utf-8") as f:
            json.dump(self.knowledge_base, f, indent=2)

        # Also create markdown documentation
        md_path = self.project_root / "OMEGA_KNOWLEDGE_BASE.md"

        with open(md_path, "w", encoding="utf-8") as f:
            f.write("# Omega Knowledge Base\n\n")
            f.write(f"Generated: {self.knowledge_base['timestamp']}\n\n")
            f.write(f"**Education Score: {self.knowledge_base['completion_score']:.1f}%**\n\n")
            f.write("---\n\n")

            for category_name, category_data in self.knowledge_base["categories"].items():
                f.write(f"## {category_name.replace('_', ' ').title()}\n\n")

                for topic, details in category_data.items():
                    f.write(f"### {topic}\n\n")

                    if isinstance(details, dict):
                        for key, value in details.items():
                            if isinstance(value, list):
                                f.write(f"**{key.replace('_', ' ').title()}:**\n\n")
                                for item in value:
                                    f.write(f"- {item}\n")
                                f.write("\n")
                            elif isinstance(value, dict):
                                f.write(f"**{key.replace('_', ' ').title()}:**\n\n")
                                for k, v in value.items():
                                    f.write(f"- **{k}**: {v}\n")
                                f.write("\n")
                            else:
                                f.write(f"**{key.replace('_', ' ').title()}:** {value}\n\n")

                    f.write("\n")

        print(f"\n   ✓ Knowledge base saved:")
        print(f"      - JSON: {report_path}")
        print(f"      - Markdown: {md_path}")

