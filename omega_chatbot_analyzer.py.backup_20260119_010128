    def get_installed_packages(self) -> Dict[str, str]:
        """Get all installed AI/chatbot related packages"""
        print("\n[*] Scanning installed AI/Chatbot packages...")

        ai_keywords = [
            "langchain",
            "openai",
            "anthropic",
            "gradio",
            "streamlit",
            "instructor",
            "llama",
            "guidance",
            "litellm",
            "transformers",
            "sentence",
        ]

        packages = {}

        try:
            result = subprocess.run(
                ["pip", "list", "--format=json"], capture_output=True, text=True, timeout=30
            )

            all_packages = json.loads(result.stdout)

            for pkg in all_packages:
                name = pkg["name"].lower()
                if any(keyword in name for keyword in ai_keywords):
                    packages[pkg["name"]] = pkg["version"]

        except Exception as e:
            print(f"[!] Error scanning packages: {e}")

        return packages

