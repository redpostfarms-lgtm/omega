# ═══════════════════════════════════════════════════════════════
# The Gatekeeper - Production Docker Image
# ═══════════════════════════════════════════════════════════════
# Multi-stage build for optimized image size

# ──────────────────────────────────────────────────────────────
# Stage 1: Builder - Install dependencies and compile extensions
# ──────────────────────────────────────────────────────────────
FROM python:3.11-slim as builder

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies for building Python packages
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    git \
    curl \
    libsndfile1-dev \
    portaudio19-dev \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy requirements file
COPY requirements.txt /tmp/requirements.txt

# Install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r /tmp/requirements.txt

# ──────────────────────────────────────────────────────────────
# Stage 2: Runtime - Minimal production image
# ──────────────────────────────────────────────────────────────
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH" \
    OMEGA_ENV=production

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    portaudio19-dev \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv

# Create application user (security best practice)
RUN useradd -m -u 1000 gatekeeper && \
    mkdir -p /app /app/data /app/logs /app/models && \
    chown -R gatekeeper:gatekeeper /app

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=gatekeeper:gatekeeper . /app/

# Switch to non-root user
USER gatekeeper

# Expose ports
EXPOSE 8000 9090

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Default command (can be overridden in docker-compose)
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]

# Labels
LABEL maintainer="The Gatekeeper Team" \
      version="1.0.0" \
      description="The Gatekeeper AI System" \
      org.opencontainers.image.source="https://github.com/yourusername/the-gatekeeper"
