  "permissions": [
    "microphone",
    "geolocation",
    "calendar",
    "storage",
    "notifications",
    "background-sync",
    "wake-lock"
  ],
  "categories": ["productivity", "utilities", "ai"],
  "screenshots": [
    {
      "src": "/static/screenshots/desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/static/screenshots/mobile.png",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "shortcuts": [
    {
      "name": "Voice Command",
      "short_name": "Voice",
      "description": "Activate voice control",
      "url": "/?voice=on",
      "icons": [{ "src": "/static/icons/voice-icon.png", "sizes": "96x96" }]
    },
    {
      "name": "Agent Council",
      "short_name": "Council",
      "description": "Summon agent council",
      "url": "/?council=open",
      "icons": [{ "src": "/static/icons/council-icon.png", "sizes": "96x96" }]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+omega",
      "url": "/handler?command=%s"
    }
  ]
}
